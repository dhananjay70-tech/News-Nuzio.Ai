# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL as specified in requirements)
DATABASE_URL="postgresql://user:password@localhost:5432/nuzio_ai?schema=public"
# Only needed if DATABASE_URL points at a connection pooler (e.g. Supabase's
# pgbouncer transaction pooler) that can't run migrations - set it to a
# direct/session connection to the same database. Optional otherwise.
DIRECT_URL=

# JWT
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRES_IN=7d

# GNews (optional, preferred live provider when set - https://gnews.io)
GNEWS_API_URL=https://gnews.io/api/v4
GNEWS_API_KEY=

# Generic NewsAPI.org-shaped provider (optional, used if GNews isn't configured)
NEWS_API_URL=https://newsapi.org/v2
NEWS_API_KEY=

# TTS - server-side only, never exposed to the frontend. Only "elevenlabs" is
# implemented today. Leave both empty to disable server audio: the main Nuzio
# player then falls back to the browser's SpeechSynthesis, but News Pulse
# "Listen" reports 503 TTS_NOT_CONFIGURED. (News Pulse Listen also uses browser
# speech when the provider is out of credits, TTS_QUOTA_EXCEEDED.) Each Listen
# spends ~1 provider credit per character read (capped at 1200), once per article.
TTS_PROVIDER=
TTS_API_KEY=

# Public URL of THIS backend, used to build the audio file URLs the browser
# plays (e.g. https://your-service.onrender.com, no trailing slash). Required in
# production or audio URLs point at localhost; on Render, RENDER_EXTERNAL_URL is
# used automatically when this is unset. Defaults to http://localhost:PORT.
BACKEND_URL=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# News Pulse - Python FastAPI AI service (Ai_Service). In production, point
# this at the deployed FastAPI URL. Never exposed to the frontend.
AI_SERVICE_URL=http://localhost:8000
# Optional timeouts in ms (defaults shown). The trigger call only enqueues a
# background job, so it gets the tighter budget.
AI_SERVICE_TIMEOUT_MS=10000
AI_SERVICE_TRIGGER_TIMEOUT_MS=5000
